# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://angel-ai-safety.vercel.app

# Supabase PostgreSQL Database Configuration (Prisma)
# Use the pooled connection (port 6543) for DATABASE_URL and direct connection (port 5432) for DIRECT_URL
DATABASE_URL="postgres://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Firebase Admin SDK Configuration (Authentication & Push Notifications)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com

# Cloudinary Configuration (Tamper-Proof AES-256 Evidence Vault)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini AI Configuration (AI Escape Coach & De-escalation Engine)
GEMINI_API_KEY=your_gemini_api_key

# Google Maps API Configuration (Nearby Safe Haven & Emergency Routing)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# API Rate Limiting & Security Defaults
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
